# 数据库配置
DB_PASSWORD=root123
DB_NAME=invoice_system
DB_USERNAME=invoice_user

# JWT 密钥配置（生产环境请更改为长于32字节的随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-bytes

# AI 智能识别配置（选填，支持 deepseek/openai 等）
AI_ENABLED=true
AI_PROVIDER=deepseek
AI_API_KEY=your-deepseek-api-key
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=20

# 文件上传大小限制（选填，默认 50MB）
FILE_MAX_SIZE=50MB
REQUEST_MAX_SIZE=50MB

# 跨域配置（选填，使用 Nginx 同源访问时无需修改）
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://127.0.0.1:8080,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
# 客户端 IP 识别（选填）：后端位于前端 Nginx 之后，只信任 Nginx 容器固定 IP（见 compose 中 frontend 的 ipv4_address）
# 发来的 X-Forwarded-For。若 Nginx 前面还有 CDN / 云负载均衡，请把其回源地址追加到 TRUSTED_PROXIES。
# 不要填整个私有网段（如 192.168.0.0/16）：内网客户端本身在该网段内，可借此伪造来源 IP 绕过限流。
# TRUST_FORWARDED_HEADERS=true
# TRUSTED_PROXIES=172.16.238.10
# 注册与验证码防刷（选填，0 表示关闭对应维度）
# 均按来源 IP 计数：多人共用一个出口 IP（公司 NAT）时可适当调大；全站上限可被分布式攻击打满，按实际注册量设置
# REGISTER_IP_HOURLY_LIMIT=3
# REGISTER_IP_DAILY_LIMIT=10
# REGISTER_SUBNET_DAILY_LIMIT=30
# REGISTER_GLOBAL_HOURLY_LIMIT=60
# CAPTCHA_FAILURE_LIMIT=10
