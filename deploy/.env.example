# 数据库配置
DB_PASSWORD=root123
DB_NAME=invoice_system
DB_USERNAME=invoice_user

# JWT 密钥配置（生产环境请更改为长于32字节的随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-bytes

# AI 智能识别配置（选填，支持 deepseek/openai 等）
AI_ENABLED=true
AI_PROVIDER=deepseek
AI_API_KEY=your-deepseek-api-key
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=20

# 跨域配置（选填，使用 Nginx 同源访问时无需修改）
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
